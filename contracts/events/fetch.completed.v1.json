{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fetch.completed.v1",
  "title": "FetchCompleted",
  "description": "Uma coleta de uma fonte terminou, com ou sem falhas. Publicado uma vez por execução do coletor.",
  "type": "object",
  "required": ["run_id", "source", "requested_from", "requested_to", "found", "stored", "skipped", "failed", "error", "started_at", "finished_at"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "enum": ["diario_prefeitura", "diario_camara"] },
    "requested_from": { "type": "string", "format": "date" },
    "requested_to": { "type": "string", "format": "date" },
    "found": { "type": "integer", "minimum": 0 },
    "stored": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "error": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
